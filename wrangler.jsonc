
{
  "name": "ekk-vercel-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "HISTORY",
      "id": "GANTI_DENGAN_ID_KV_KAMU"
    }
  ]
}
