
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ekk-vercel-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "HISTORY",
      "id": "8ceedf2a5c57469b9e7be2ce962c31bb"
    }
  ]
}
